{
  "server_base_url": "http://172.16.52.76:3000",
  "socketio_path": "ws",
  "state_file": "state.json",
  "history_file": "call_history.json",
  "incoming_timeout_seconds": 60,
  "camera_index": 0,
  "camera_fps": 30,
  "camera_warmup_seconds": 1.2,
  "sample_fps": 15,
  "chunk_frames": 15,
  "frame_width": 640,
  "frame_height": 480,
  "jpeg_quality": 72,
  "preview_max_fps": 6,
  "preview_width": 426,
  "preview_height": 320,
  "upload_workers": 2,
  "max_pending_uploads": 4,
  "video_chunk_interval_seconds": 0.0,
  "capture_command": [
    "libcamera-vid",
    "-t",
    "{duration_ms}",
    "--width",
    "640",
    "--height",
    "480",
    "--framerate",
    "15",
    "--fullscreen",
    "--codec",
    "h264",
    "-o",
    "{output}"
  ],
  "player_command": [
    "mpv",
    "--fs",
    "--really-quiet",
    "{url}"
  ],
  "ringtone_command": [
    "aplay",
    "{file}"
  ]
}
